{
  "provider": "kubernetes",
  "action": "k8s:core/v1/secrets/create",
  "target": "clusters/staging-eu/namespaces/checkout/secrets/checkout-db",
  "parameters": {
    "type": "Opaque",
    "data": {
      "password": "{{secret:kv-checkout-stg/db-password}}"
    },
    "metadata": {
      "labels": {
        "app": "checkout-api"
      }
    }
  },
  "idempotency_key": "create-secret-checkout-db-01",
  "justification": "Wire the deployment to the existing staging database without ever reading the value."
}
